{
  "cleanUrls": true,
  "functions": {
    "api/spotisaver.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/rbsc/:path*", "destination": "/api/rbsc" }
  ],
  "headers": [
    { "source": "/sitemap.xsl", "headers": [{ "key": "Content-Type", "value": "text/xsl; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] }
  ],
  "redirects": [
    {
      "source": "/songcontest",
      "destination": "https://youtube.com/live/iE7edeygWks?feature=share",
      "permanent": false
    },
    {
      "source": "/network",
      "destination": "/companies",
      "permanent": true
    }
  ]
}
