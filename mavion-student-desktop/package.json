{
  "name": "mavion-go-lock",
  "version": "1.3.2",
  "description": "Mavion Go Lock for Windows",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "gg.tmc.mavionstudentdesktop",
  "productName": "Mavion Go Lock",
    "icon": "assets/mavion-lock.ico",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "renderer/**/*", "assets/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mavion Go Lock"
    }
  }
}
